# HTTP server. Keep loopback-only unless remote access is intentional.
PORT=42010
HOST=127.0.0.1
# AGENTMANAGER_ALLOW_LAN=true

# Storage and logging
# AGENTMANAGER_DB_PATH=/absolute/path/to/agentmanager.db
LOG_LEVEL=info

# Set this only when the dashboard is served through HTTPS.
AGENTMANAGER_HTTPS=false

# Event hooks get a generated per-install secret automatically. To provide a
# stable master secret yourself, use at least 32 random characters.
# AGENTMANAGER_HOOK_SECRET=
# Set false after all existing project hooks have been reinstalled.
AGENTMANAGER_ALLOW_LEGACY_LOCAL_HOOKS=true

# Session persistence
AGENTMANAGER_USE_TMUX=true
AGENTMANAGER_USE_DTACH=true

# Abuse controls
AGENTMANAGER_LOGIN_RATE_LIMIT_MAX=5
AGENTMANAGER_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AGENTMANAGER_LOGIN_BLOCK_MS=60000
AGENTMANAGER_EVENT_RATE_LIMIT_PER_MINUTE=300
AGENTMANAGER_EVENT_RETENTION_MAX=50000
AGENTMANAGER_EVENT_RETENTION_DAYS=30
